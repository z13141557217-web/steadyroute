.DS_Store
__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.local
dist/
build/
artifacts/
coverage/

# Runtime and production data must never enter source control.
state.json
router.lock
*.log
*.log.*
*.sock
*.pid
backups/

# Secrets and subscription material.
*subscription*
*credentials*
*secret*
*.key
*.pem


# Installed instance metadata and lifecycle state stay on the local machine.
service-instance.json
control-state.json
control.lock
