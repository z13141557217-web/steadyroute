#!/bin/sh
set -eu

if [ "${STEADYROUTE_ALLOW_MAIN_PUSH:-0}" = "1" ]; then
  echo "SteadyRoute: direct main push override accepted for this command."
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    cat >&2 <<'EOF'
SteadyRoute blocks direct pushes to main on this machine.

Use a feature branch and Pull Request:
  git switch -c feat/short-name
  git push -u origin HEAD

For a documented emergency only:
  STEADYROUTE_ALLOW_MAIN_PUSH=1 git push origin main
EOF
    exit 1
  fi
done

